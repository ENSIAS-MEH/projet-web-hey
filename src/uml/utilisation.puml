@startuml
left to right direction
skinparam packageStyle rectangle

actor "Patient" as P
actor "Médecin" as M

rectangle "Système MediTrack" {
    usecase "S'authentifier" as UC_Auth
    usecase "Gérer son profil" as UC_Profil
    usecase "Saisir des constantes vitales" as UC_Saisir
    usecase "Consulter son historique" as UC_Histo
    usecase "Prendre un rendez-vous" as UC_RDV_P
    usecase "Consulter les dossiers patients" as UC_Dossier
    usecase "Recevoir des alertes" as UC_Alerte
    usecase "Gérer les rendez-vous" as UC_RDV_M
    usecase "Générer une alerte métier" as UC_GenAlerte
}

P --> UC_Auth
M --> UC_Auth
P --> UC_Profil
P --> UC_Saisir
P --> UC_Histo
P --> UC_RDV_P
M --> UC_Dossier
M --> UC_Alerte
M --> UC_RDV_M

UC_Saisir ..> UC_GenAlerte: <<extend>> \n(Si constantes anormales)
UC_Profil ..> UC_Auth: <<include>>
UC_Saisir ..> UC_Auth: <<include>>
UC_Histo ..> UC_Auth: <<include>>
UC_Dossier ..> UC_Auth: <<include>>
UC_RDV_P ..> UC_Auth: <<include>>
UC_RDV_M ..> UC_Auth: <<include>>
@enduml